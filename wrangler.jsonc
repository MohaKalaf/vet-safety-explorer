{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vet-safety-explorer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // must match "name" above
    { "binding": "WORKER_SELF_REFERENCE", "service": "vet-safety-explorer" }
  ],
  // Cache for openFDA results (unstable_cache)
  "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "ced6d2c8746845bd9b470f913e926125" }],
  "routes": [{ "pattern": "vetsafety.mohammadkalaf.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
